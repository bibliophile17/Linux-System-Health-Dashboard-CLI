# OPTIONAL hardened systemd unit for the exporter. Adjust ExecStart to where you installed syshealth.
# Install:  sudo cp monitoring/syshealth-exporter.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now syshealth-exporter
# Remove:   sudo systemctl disable --now syshealth-exporter && sudo rm /etc/systemd/system/syshealth-exporter.service
[Unit]
Description=syshealth Prometheus exporter (loopback only)
After=network.target

[Service]
ExecStart=/usr/local/bin/syshealth exporter --host 127.0.0.1 --port 9877
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
